# Conexões (Postgres puro). Em dev: docker compose up -d
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:56432/gestao
DATABASE_URL=postgres://app_api:dev_app_api@127.0.0.1:56432/gestao
SERVICE_DATABASE_URL=postgres://app_service:dev_app_service@127.0.0.1:56432/gestao
APP_API_PASSWORD=dev_app_api
APP_SERVICE_PASSWORD=dev_app_service

PORT=56080
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
PUBLIC_APP_NAME=[NOME_DO_APP]

# E-mail (dev: Mailpit em http://localhost:56025)
SMTP_URL=smtp://127.0.0.1:56026
MAIL_FROM="Gestão Financeira <nao-responda@example.com>"

# SMS e WhatsApp (Twilio). Sem credenciais, os envios são SIMULADOS e registrados.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Push (Expo). Opcional: token de acesso para push com segurança reforçada.
EXPO_ACCESS_TOKEN=

# Login social (IDs aceitos no "aud" do token)
APPLE_BUNDLE_IDS=com.example.gestaofinanceira,com.example.gestaofinanceira.dev
GOOGLE_CLIENT_IDS=

# RevenueCat
REVENUECAT_WEBHOOK_AUTH=

# Contas de revisão/teste com código fixo (formato email:codigo,email:codigo). Nunca use em contas reais.
FIXED_OTP_ACCOUNTS=
