{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/db/seed-demo.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
