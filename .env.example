# Copie para:
#   apps/api/.env       (API + worker)  → veja apps/api/.env.example (completo)
#   apps/mobile/.env    (Expo; valores públicos)
#   apps/admin/.env.local

# --- Mobile (Expo; valores públicos — vão para o bundle) ---
# No celular físico use o IP da sua máquina na rede (ex.: http://192.168.0.10:56080)
EXPO_PUBLIC_API_URL=http://127.0.0.1:56080
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EAS_PROJECT_ID=

# --- Admin (Next.js; server-side) ---
API_URL=http://127.0.0.1:56080

# --- Build (EAS env) ---
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_APP_STORE_ID=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
